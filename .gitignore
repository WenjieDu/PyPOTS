# ignore special files or folds
*~
.idea
.DS_Store

# ignore all building results
dist
build
docs/_build
*.egg-info

# ignore all testing/running results
.run
.coverage
.pytest_cache
*__pycache__*
*results*
*test*
!tests/
!/tests/**/*.py
!/tests/**/*.pyi

# ignore specific kinds of files like all PDFs
*.pdf
*.ipynb
*TODO*

# ignore executable and config files
*.sh
!/scripts/build_and_run_sphinx_docs.sh
*.yml
!/.github/workflows/*.yml

# to temporally ignore things under development locally, simply append '_indev' to the name of your workdir
*_indev*

# Track localized READMEs even when a global ignore excludes Markdown files
!/i18n/README_*.md

# Track maintainer documentation even with global Markdown ignores
!/.github/SECURITY_MAINTENANCE.md
!/.github/RELEASE_MAINTENANCE.md
